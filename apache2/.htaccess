# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(db\.php|auth_config\.php|seeder\.php|login_process\.php|logout\.php)$">
    # Allow access (these are included by other scripts)
</FilesMatch>

# Deny access to hidden files
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
