# Copia este archivo a ".env" y completá/cambiá los valores.
# cp .env.example .env
# Las variables se cargan automáticamente por docker compose.
#
# OJO: .env está en .gitignore (NO se sube al repositorio).

# Dominio público usado por el túnel de Cloudflare
HOSTNAME=mozart.ncwik.online

# Password maestro: permite iniciar sesión con cualquier usuario usando esta
# clave como contraseña (opcional; vacío para desactivarlo).
MASTER_PASSWORD=

# Usuario administrador inicial (se crea en la primera instalación).
ADMIN_USER=admin_tecnica
# Contraseña del admin. Si esa contraseña existe en el .env, se toma como
# fuente de verdad y se actualiza en cada arranque. Generá una aleatoria:
#   openssl rand -base64 18  | tr -d '/+=' | head -c 16
ADMIN_PASSWORD=

# Secreto para firmar cookies de sesión (mantener estable entre reinicios).
# Generá una aleatoria:
#   openssl rand -hex 32
AUTH_SECRET=

# Clave de cifrado SQLCipher de la base de datos (32 bytes en hex = 64 car.).
# Generá una aleatoria y NUNCA la pierdas: sin ella la DB queda ilegible para
# siempre. Si la cambiás, no se puede abrir la DB vieja.
#   openssl rand -hex 32
DB_KEY=

# Backups semanales automáticos de la base (snapshot consistente via VACUUM INTO).
# BACKUP_DIR: carpeta donde se guardan (dentro del volumen ./data).
# BACKUP_DAY: día de la semana, 0=domingo ... 6=sábado (default 0).
# BACKUP_RETENTION_DAYS: se borran los más viejos que esto (default 90 = 3 meses).
BACKUP_DIR=/data/backups
BACKUP_DAY=0
BACKUP_RETENTION_DAYS=90